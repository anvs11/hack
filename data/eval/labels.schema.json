{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/analysis-eval-labels-v1.json",
  "title": "Analysis evaluation labels v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "purpose",
    "frozen_at",
    "independent_labels",
    "quality_claim_allowed",
    "items"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["plumbing_smoke", "quality_benchmark"]},
    "frozen_at": {"type": "string", "format": "date-time"},
    "independent_labels": {"type": "boolean"},
    "quality_claim_allowed": {"type": "boolean"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publication_id",
          "expected_category",
          "expected_priority",
          "label_source",
          "annotator_id",
          "notes"
        ],
        "properties": {
          "publication_id": {"type": "string", "minLength": 1},
          "expected_category": {
            "enum": ["regulation", "reputation", "competitor", "trend", "unknown"]
          },
          "expected_priority": {
            "enum": ["critical", "high", "medium", "low", "unknown"]
          },
          "label_source": {"enum": ["independent_manual", "replay_fixture"]},
          "annotator_id": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {
              "properties": {"label_source": {"const": "independent_manual"}},
              "required": ["label_source"]
            },
            "then": {
              "properties": {"annotator_id": {"type": "string", "minLength": 1}}
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"quality_claim_allowed": {"const": true}},
        "required": ["quality_claim_allowed"]
      },
      "then": {
        "properties": {"independent_labels": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {"purpose": {"const": "plumbing_smoke"}},
        "required": ["purpose"]
      },
      "then": {
        "properties": {"quality_claim_allowed": {"const": false}}
      }
    }
  ]
}
