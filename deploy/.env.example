# Public hostname pointing to the VPS, for example hack.203-0-113-10.sslip.io
APP_DOMAIN=hack.example.com

# Poll enabled live sources every 30 minutes.
HACK_COLLECTION_INTERVAL_SECONDS=1800

# BotFather token is stored in deploy/secrets/telegram_bot_token.
HACK_TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Cheap VPS mode: keep model inference outside the web server.
HACK_LLM_PROVIDER=openai_compatible
HACK_LLM_API_BASE_URL=https://provider.example/v1
# API key is stored in deploy/secrets/llm_api_key.
HACK_LLM_API_MODEL_ID=Qwen/Qwen3.5-0.8B
HACK_LLM_API_TIMEOUT_SECONDS=120
# Structured analysis needs room for summary, entities, criteria and evidence.
HACK_LLM_MAX_NEW_TOKENS=1024
# Optional for reasoning models exposed by compatible providers (for example CloudCompute Qwen).
HACK_LLM_REASONING_EFFORT=

# Measured CloudCompute example (replace the generic values above):
# HACK_LLM_API_BASE_URL=https://app.cloudcompute.ru/api/v1
# HACK_LLM_API_MODEL_ID=qwen/qwen3.8-flash
# HACK_LLM_REASONING_EFFORT=none
