{$APP_DOMAIN:localhost} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv

        @versioned_assets path /assets/* /fonts/* /favicon.svg
        header @versioned_assets Cache-Control "public, max-age=31536000, immutable"

        @spa_shell not path /assets/* /fonts/* /favicon.svg
        header @spa_shell Cache-Control "no-store"

        try_files {path} /index.html
        file_server
    }
}
